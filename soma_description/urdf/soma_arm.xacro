<?xml version="1.0"?>
<!--
  SOMA 6DOF aluminum arm, one reusable xacro macro.

  Hardware: "6DOF metal robot arm" sold by ThanksBuyer / Red Sun Global
  (AliExpress item 1005007215923987), bought as the "Arm Only" variant and
  fitted with our own MG996R servos. The kit manual labels the joints A to
  F; the joint NAMES below keep that lineage (they are also the driver's
  channel labels in servo_map.py, so they never change lightly).

  MEASURED TRUTH, 2026-08-05 caliper session. The arm as actually built
  and mounted is NOT the manual's upright yaw-first chain:

    - The arm HANGS from its slew disc. The disc axis (J1) is HORIZONTAL,
      pointing outboard. J1 swings the whole arm forward/backward like a
      pendulum.
    - J1, J2 (shoulder), J3 (elbow) and J4 (wrist pitch) axes are ALL
      PARALLEL: the arm is a planar 4R chain in its own vertical plane,
      redundant like a finger. J5 (wrist roll) spins the gripper about
      the forearm axis and is what moves the fingertips out of plane.
    - A 33 mm link Andres named "the clavicle" joins the disc center to
      the shoulder axis.

  Local frame of the macro root (${prefix}mount_link), chosen so one rpy
  at the mount does all the work:
    +Z  along the disc axis, pointing OUTBOARD (away from the bench box)
    +X  the chain direction at zero pose (world DOWN once mounted)
  Mount with rpy such that +X maps to world -Z; see soma_bench.urdf.xacro.

  The `side` parameter mirrors the joint SENSE, not the geometry: the hug
  convention (negative = inward, closing a hug; positive = outward/up) is
  mirror-symmetric between arms by definition, so the left arm uses
  side=1 and the right arm side=-1 on every revolute axis.

  AXIS SIGNS ARE PROVISIONAL: lengths, parallelism and anchors are
  caliper-measured; the world-direction of each joint's positive sense
  still needs the first powered RViz-vs-reality comparison (v0.2 session,
  one small commanded angle per joint). A wrong sense is a one-line flip
  here plus the same flip in the mirror. Do not "fix" signs from the
  armchair; fix them from the bench.

  Visuals are honest bounding boxes; pretty geometry arrives with the
  CAD-to-URDF pipeline (task #30). Roughly 0.7 kg per hanging arm (the
  base boxes now live in the bench model).
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============ dimensions, MEASURED 2026-08-05 ============
       Every literal here has a provenance row in config/dimensions.yaml;
       test_dimensions_sync.py keeps the two in agreement. -->
  <xacro:property name="disc_r"         value="0.02455"/> <!-- slew disc, the one that rotates -->
  <xacro:property name="disc_h"         value="0.0074"/>  <!-- disc protrusion from its box -->
  <xacro:property name="clavicle_len"   value="0.033"/>   <!-- disc center to shoulder axis -->
  <xacro:property name="upper_len"      value="0.0793"/>  <!-- shoulder to elbow -->
  <xacro:property name="fore_len"       value="0.075"/>   <!-- elbow to wrist pitch -->
  <xacro:property name="wrist_len"      value="0.0664"/>  <!-- wrist pitch to gripper mount face -->
  <xacro:property name="gripper_base_h" value="0.0179"/>  <!-- mount face to finger gear axes -->
  <xacro:property name="finger_len"     value="0.0657"/>  <!-- gear axis to fingertip -->
  <xacro:property name="finger_sep"     value="0.0257"/>  <!-- between the two gear axes -->
  <xacro:property name="plate_w"        value="0.0319"/>  <!-- link plate width -->
  <xacro:property name="plate_t"        value="0.0528"/>  <!-- arm sandwich outer width -->

  <!-- MG996R class servo, 40x20 body (datasheet) -->
  <xacro:property name="servo_lx" value="0.041"/>
  <xacro:property name="servo_ly" value="0.020"/>
  <xacro:property name="servo_lz" value="0.038"/>

  <!-- Limits: MEASURED on 2026-08-03, joint by joint, after re-splining
       every horn so the mechanical zero matches the electrical center.
       Convention (Andres's "hug rule"): negative = inward, as if the robot
       were closing a hug, grasping features facing forward; positive =
       outward/up. Limits are asymmetric and differ per side, so they are
       macro parameters below (defaults = RIGHT arm; the bench passes the
       left values). They MUST stay in sync with SERVO_MAP in
       soma_driver/servo_map.py; CI checks exactly that. -->
  <xacro:property name="effort_nm"  value="1.0"/>   <!-- MG996R ~10 kg.cm = 0.98 N.m -->
  <xacro:property name="vel_rads"   value="3.0"/>   <!-- ~0.17 s/60 deg plus margin -->

  <!-- ==================== inertia macros ==================== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12.0}" iyy="${m*(x*x+z*z)/12.0}"
               izz="${m*(x*x+y*y)/12.0}" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12.0}" iyy="${m*(3*r*r+h*h)/12.0}"
               izz="${m*r*r/2.0}" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <!-- ==================== the arm macro ==================== -->
  <xacro:macro name="soma_arm"
               params="prefix parent side:=1 *origin
                       yaw_lower:=-2.7960 yaw_upper:=0.3456
                       shoulder_lower:=-0.4712 shoulder_upper:=2.3562
                       elbow_lower:=-2.1363 elbow_upper:=0.9739
                       wrist_pitch_lower:=-2.0420 wrist_pitch_upper:=0.8482
                       wrist_roll_lower:=-1.8222 wrist_roll_upper:=1.2724">

    <!-- mount to the parent link, at the disc seat on the bench box -->
    <joint name="${prefix}mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}mount_link"/>
      <xacro:insert_block name="origin"/>
    </joint>
    <link name="${prefix}mount_link"/>

    <!-- A: the slew disc, J1. Horizontal axis, the arm's fore/aft swing. -->
    <joint name="${prefix}yaw_joint" type="revolute">
      <parent link="${prefix}mount_link"/>
      <child link="${prefix}turntable_link"/>
      <origin xyz="0 0 0"/>
      <axis xyz="0 0 ${side}"/>
      <limit lower="${yaw_lower}" upper="${yaw_upper}" effort="${effort_nm}" velocity="${vel_rads}"/>
    </joint>

    <!-- disc plus the clavicle bracket that carries the shoulder servo -->
    <link name="${prefix}turntable_link">
      <visual>
        <origin xyz="0 0 ${disc_h/2}"/>
        <geometry><cylinder radius="${disc_r}" length="${disc_h}"/></geometry>
        <material name="dark_gray"/>
      </visual>
      <visual>
        <origin xyz="${clavicle_len/2} 0 ${disc_h + 0.003}"/>
        <geometry><box size="${clavicle_len + 0.030} 0.030 0.006"/></geometry>
        <material name="aluminum"/>
      </visual>
      <collision>
        <origin xyz="${clavicle_len/2} 0 ${disc_h/2 + 0.003}"/>
        <geometry><box size="${clavicle_len + 2*disc_r} 0.050 ${disc_h + 0.006}"/></geometry>
      </collision>
      <xacro:box_inertia m="0.10" x="${clavicle_len + 2*disc_r}" y="0.05" z="${disc_h + 0.006}"/>
    </link>

    <!-- B: shoulder. PARALLEL to J1, one clavicle away. -->
    <joint name="${prefix}shoulder_joint" type="revolute">
      <parent link="${prefix}turntable_link"/>
      <child link="${prefix}upper_arm_link"/>
      <origin xyz="${clavicle_len} 0 ${disc_h}"/>
      <axis xyz="0 0 ${side}"/>
      <limit lower="${shoulder_lower}" upper="${shoulder_upper}" effort="${effort_nm}" velocity="${vel_rads}"/>
    </joint>

    <link name="${prefix}upper_arm_link">
      <visual>
        <origin xyz="${upper_len/2} 0 0"/>
        <geometry><box size="${upper_len} ${plate_w} ${plate_t}"/></geometry>
        <material name="aluminum"/>
      </visual>
      <collision>
        <origin xyz="${upper_len/2} 0 0"/>
        <geometry><box size="${upper_len + 0.02} ${plate_w + 0.01} ${plate_t + 0.01}"/></geometry>
      </collision>
      <xacro:box_inertia m="0.18" x="${upper_len}" y="${plate_w}" z="${plate_t}"/>
    </link>

    <!-- C: elbow (twin servo block). Parallel again. -->
    <joint name="${prefix}elbow_joint" type="revolute">
      <parent link="${prefix}upper_arm_link"/>
      <child link="${prefix}forearm_link"/>
      <origin xyz="${upper_len} 0 0"/>
      <axis xyz="0 0 ${side}"/>
      <limit lower="${elbow_lower}" upper="${elbow_upper}" effort="${effort_nm}" velocity="${vel_rads}"/>
    </joint>

    <link name="${prefix}forearm_link">
      <visual>
        <origin xyz="${fore_len/2} 0 0"/>
        <geometry><box size="${fore_len} ${plate_w} ${plate_t}"/></geometry>
        <material name="aluminum"/>
      </visual>
      <collision>
        <origin xyz="${fore_len/2} 0 0"/>
        <geometry><box size="${fore_len + 0.02} ${plate_w + 0.01} ${plate_t + 0.01}"/></geometry>
      </collision>
      <xacro:box_inertia m="0.16" x="${fore_len}" y="${plate_w}" z="${plate_t}"/>
    </link>

    <!-- D: wrist pitch. Last of the parallel four. -->
    <joint name="${prefix}wrist_pitch_joint" type="revolute">
      <parent link="${prefix}forearm_link"/>
      <child link="${prefix}wrist_link"/>
      <origin xyz="${fore_len} 0 0"/>
      <axis xyz="0 0 ${side}"/>
      <limit lower="${wrist_pitch_lower}" upper="${wrist_pitch_upper}" effort="${effort_nm}" velocity="${vel_rads}"/>
    </joint>

    <link name="${prefix}wrist_link">
      <visual>
        <origin xyz="${wrist_len/2} 0 0"/>
        <geometry><box size="${wrist_len} 0.040 0.045"/></geometry>
        <material name="aluminum"/>
      </visual>
      <collision>
        <origin xyz="${wrist_len/2} 0 0"/>
        <geometry><box size="${wrist_len} 0.045 0.050"/></geometry>
      </collision>
      <xacro:box_inertia m="0.09" x="${wrist_len}" y="0.04" z="0.045"/>
    </link>

    <!-- E: wrist roll, about the forearm axis. The out-of-plane joint. -->
    <joint name="${prefix}wrist_roll_joint" type="revolute">
      <parent link="${prefix}wrist_link"/>
      <child link="${prefix}gripper_base_link"/>
      <origin xyz="${wrist_len} 0 0"/>
      <axis xyz="${side} 0 0"/>
      <limit lower="${wrist_roll_lower}" upper="${wrist_roll_upper}" effort="${effort_nm}" velocity="${vel_rads}"/>
    </joint>

    <link name="${prefix}gripper_base_link">
      <visual>
        <origin xyz="${gripper_base_h/2} 0 0"/>
        <geometry><box size="${gripper_base_h} 0.038 0.045"/></geometry>
        <material name="dark_gray"/>
      </visual>
      <collision>
        <origin xyz="${gripper_base_h/2} 0 0"/>
        <geometry><box size="${gripper_base_h} 0.038 0.045"/></geometry>
      </collision>
      <xacro:box_inertia m="0.12" x="${gripper_base_h}" y="0.038" z="0.045"/>
    </link>

    <!-- F: geared gripper. Left finger is driven, right one mirrors it. -->
    <joint name="${prefix}finger_l_joint" type="revolute">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}finger_l_link"/>
      <origin xyz="${gripper_base_h} 0 ${finger_sep/2}"/>
      <axis xyz="0 1 0"/>
      <limit lower="0.0" upper="1.0" effort="${effort_nm}" velocity="${vel_rads}"/>
    </joint>
    <link name="${prefix}finger_l_link">
      <visual>
        <origin xyz="${finger_len/2} 0 0.004"/>
        <geometry><box size="${finger_len} 0.010 0.008"/></geometry>
        <material name="aluminum"/>
      </visual>
      <collision>
        <origin xyz="${finger_len/2} 0 0.004"/>
        <geometry><box size="${finger_len} 0.010 0.008"/></geometry>
      </collision>
      <xacro:box_inertia m="0.03" x="${finger_len}" y="0.01" z="0.008"/>
    </link>

    <joint name="${prefix}finger_r_joint" type="revolute">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}finger_r_link"/>
      <origin xyz="${gripper_base_h} 0 ${-finger_sep/2}"/>
      <axis xyz="0 1 0"/>
      <limit lower="-1.0" upper="0.0" effort="${effort_nm}" velocity="${vel_rads}"/>
      <mimic joint="${prefix}finger_l_joint" multiplier="-1.0"/>
    </joint>
    <link name="${prefix}finger_r_link">
      <visual>
        <origin xyz="${finger_len/2} 0 -0.004"/>
        <geometry><box size="${finger_len} 0.010 0.008"/></geometry>
        <material name="aluminum"/>
      </visual>
      <collision>
        <origin xyz="${finger_len/2} 0 -0.004"/>
        <geometry><box size="${finger_len} 0.010 0.008"/></geometry>
      </collision>
      <xacro:box_inertia m="0.03" x="${finger_len}" y="0.01" z="0.008"/>
    </link>

    <!-- tool frame (gripper tip, the IK target for MoveIt2) -->
    <joint name="${prefix}tool0_joint" type="fixed">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}tool0"/>
      <origin xyz="${gripper_base_h + finger_len} 0 0"/>
    </joint>
    <link name="${prefix}tool0"/>

  </xacro:macro>
</robot>
