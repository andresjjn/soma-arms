<?xml version="1.0"?>
<!--
  SOMA 6DOF aluminum arm, one reusable xacro macro.

  Hardware: "6DOF metal robot arm" sold by ThanksBuyer / Red Sun Global
  (AliExpress item 1005007215923987), bought as the "Arm Only" variant and
  fitted with our own MG996R servos. The kit ships a 30 page assembly
  manual; page 28 labels the six joints A to F on the physical arm, and
  that labelling is the source of the chain below. Full part numbers and
  datasheets: docs/hardware.md.

  Chain, exactly as the manual labels it:
    A = base yaw (on the large slew bearing)  -> ${prefix}yaw_joint         (Z)
    B = shoulder pitch                        -> ${prefix}shoulder_joint    (Y)
    C = elbow pitch (twin servo block)        -> ${prefix}elbow_joint       (Y)
    D = wrist pitch                           -> ${prefix}wrist_pitch_joint (Y)
    E = wrist roll                            -> ${prefix}wrist_roll_joint  (local Z)
    F = geared two finger gripper             -> ${prefix}finger_l_joint + mimic

  Servos: 40x20 body, 25T spline. The frame is designed for 25 kg.cm class
  servos; we fit MG996R (about 10 kg.cm), so shoulder and base are the
  joints to watch under load. Swapping just those two for a stronger servo
  is a non destructive upgrade.

  EVERY length below is marked [calibrate]: they are estimated from the
  manual photos and from the standard dimensions of this frame family.
  They get measured with calipers and corrected here ONCE, and the whole
  model follows. This is the deliverable of v0.1.

  Modelled in the "candle" pose (arm pointing along +Z, every joint at
  zero). REP-103 convention. Roughly 0.9 kg per arm with six servos.
-->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ==================== dimensions [calibrate] ==================== -->
  <xacro:property name="base_lx"        value="0.095"/>  <!-- base box, houses servo A -->
  <xacro:property name="base_ly"        value="0.095"/>
  <xacro:property name="base_lz"        value="0.062"/>
  <xacro:property name="turntable_r"    value="0.042"/>  <!-- disc on the slew bearing -->
  <xacro:property name="turntable_h"    value="0.012"/>
  <xacro:property name="shoulder_off_z" value="0.045"/>  <!-- disc to shoulder axis -->
  <xacro:property name="upper_len"      value="0.120"/>  <!-- shoulder to elbow -->
  <xacro:property name="fore_len"       value="0.090"/>  <!-- elbow to wrist pitch -->
  <xacro:property name="wrist_len"      value="0.055"/>  <!-- wrist pitch to roll flange -->
  <xacro:property name="gripper_base_h" value="0.045"/>  <!-- roll flange to finger axis -->
  <xacro:property name="finger_len"     value="0.075"/>  <!-- geared finger -->
  <xacro:property name="finger_sep"     value="0.024"/>  <!-- gear axis separation -->
  <xacro:property name="plate_w"        value="0.030"/>  <!-- link plate width -->
  <xacro:property name="plate_t"        value="0.060"/>  <!-- plate pair depth -->

  <!-- MG996R class servo, 40x20 body -->
  <xacro:property name="servo_lx" value="0.041"/>
  <xacro:property name="servo_ly" value="0.020"/>
  <xacro:property name="servo_lz" value="0.038"/>

  <!-- Limits: 180 degree servos, so +/- 90 from center. These MUST stay in
       sync with SERVO_MAP in soma_driver/servo_map.py. -->
  <xacro:property name="lim"        value="${pi/2}"/>
  <xacro:property name="effort_nm"  value="1.0"/>   <!-- MG996R ~10 kg.cm = 0.98 N.m -->
  <xacro:property name="vel_rads"   value="3.0"/>   <!-- ~0.17 s/60 deg plus margin -->

  <!-- ==================== inertia macros ==================== -->
  <xacro:macro name="box_inertia" params="m x y z">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(y*y+z*z)/12.0}" iyy="${m*(x*x+z*z)/12.0}"
               izz="${m*(x*x+y*y)/12.0}" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>
  <xacro:macro name="cylinder_inertia" params="m r h">
    <inertial>
      <mass value="${m}"/>
      <inertia ixx="${m*(3*r*r+h*h)/12.0}" iyy="${m*(3*r*r+h*h)/12.0}"
               izz="${m*r*r/2.0}" ixy="0" ixz="0" iyz="0"/>
    </inertial>
  </xacro:macro>

  <!-- visual of a 40x20 servo (red box) -->
  <xacro:macro name="servo_visual" params="xyz rpy:='0 0 0'">
    <visual>
      <origin xyz="${xyz}" rpy="${rpy}"/>
      <geometry><box size="${servo_lx} ${servo_ly} ${servo_lz}"/></geometry>
      <material name="servo_red"/>
    </visual>
  </xacro:macro>

  <!-- ==================== the arm macro ==================== -->
  <xacro:macro name="soma_arm" params="prefix parent *origin">

    <!-- mount to the parent link -->
    <joint name="${prefix}mount_joint" type="fixed">
      <parent link="${parent}"/>
      <child link="${prefix}base_link"/>
      <xacro:insert_block name="origin"/>
    </joint>

    <!-- base: metal box holding servo A and the wiring -->
    <link name="${prefix}base_link">
      <visual>
        <origin xyz="0 0 ${base_lz/2}"/>
        <geometry><box size="${base_lx} ${base_ly} ${base_lz}"/></geometry>
        <material name="aluminum"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${base_lz/2}"/>
        <geometry><box size="${base_lx} ${base_ly} ${base_lz}"/></geometry>
      </collision>
      <xacro:box_inertia m="0.25" x="${base_lx}" y="${base_ly}" z="${base_lz}"/>
    </link>

    <!-- A: base yaw on the slew bearing -->
    <joint name="${prefix}yaw_joint" type="revolute">
      <parent link="${prefix}base_link"/>
      <child link="${prefix}turntable_link"/>
      <origin xyz="0 0 ${base_lz}"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-lim}" upper="${lim}" effort="${effort_nm}" velocity="${vel_rads}"/>
    </joint>

    <link name="${prefix}turntable_link">
      <visual>
        <origin xyz="0 0 ${turntable_h/2}"/>
        <geometry><cylinder radius="${turntable_r}" length="${turntable_h}"/></geometry>
        <material name="dark_gray"/>
      </visual>
      <!-- shoulder yoke -->
      <visual>
        <origin xyz="0 0 ${turntable_h + shoulder_off_z/2}"/>
        <geometry><box size="0.050 0.070 ${shoulder_off_z}"/></geometry>
        <material name="aluminum"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${(turntable_h + shoulder_off_z)/2}"/>
        <geometry><box size="0.070 0.080 ${turntable_h + shoulder_off_z}"/></geometry>
      </collision>
      <xacro:box_inertia m="0.12" x="0.07" y="0.08" z="${turntable_h + shoulder_off_z}"/>
    </link>

    <!-- B: shoulder -->
    <joint name="${prefix}shoulder_joint" type="revolute">
      <parent link="${prefix}turntable_link"/>
      <child link="${prefix}upper_arm_link"/>
      <origin xyz="0 0 ${turntable_h + shoulder_off_z}"/>
      <axis xyz="0 1 0"/>
      <limit lower="${-lim}" upper="${lim}" effort="${effort_nm}" velocity="${vel_rads}"/>
    </joint>

    <link name="${prefix}upper_arm_link">
      <visual>
        <origin xyz="0 0 ${upper_len/2}"/>
        <geometry><box size="${plate_w} ${plate_t} ${upper_len}"/></geometry>
        <material name="aluminum"/>
      </visual>
      <xacro:servo_visual xyz="0 ${plate_t/2 + servo_ly/2} 0"/>
      <collision>
        <origin xyz="0 0 ${upper_len/2}"/>
        <geometry><box size="${plate_w} ${plate_t + 2*servo_ly} ${upper_len}"/></geometry>
      </collision>
      <xacro:box_inertia m="0.18" x="${plate_w}" y="${plate_t}" z="${upper_len}"/>
    </link>

    <!-- C: elbow (twin servo block, manual page 15) -->
    <joint name="${prefix}elbow_joint" type="revolute">
      <parent link="${prefix}upper_arm_link"/>
      <child link="${prefix}forearm_link"/>
      <origin xyz="0 0 ${upper_len}"/>
      <axis xyz="0 1 0"/>
      <limit lower="${-lim}" upper="${lim}" effort="${effort_nm}" velocity="${vel_rads}"/>
    </joint>

    <link name="${prefix}forearm_link">
      <visual>
        <origin xyz="0 0 ${fore_len/2}"/>
        <geometry><box size="${plate_w} ${plate_t} ${fore_len}"/></geometry>
        <material name="aluminum"/>
      </visual>
      <xacro:servo_visual xyz="0 ${-(plate_t/2 + servo_ly/2)} 0"/>
      <collision>
        <origin xyz="0 0 ${fore_len/2}"/>
        <geometry><box size="${plate_w} ${plate_t + 2*servo_ly} ${fore_len}"/></geometry>
      </collision>
      <xacro:box_inertia m="0.16" x="${plate_w}" y="${plate_t}" z="${fore_len}"/>
    </link>

    <!-- D: wrist pitch -->
    <joint name="${prefix}wrist_pitch_joint" type="revolute">
      <parent link="${prefix}forearm_link"/>
      <child link="${prefix}wrist_link"/>
      <origin xyz="0 0 ${fore_len}"/>
      <axis xyz="0 1 0"/>
      <limit lower="${-lim}" upper="${lim}" effort="${effort_nm}" velocity="${vel_rads}"/>
    </joint>

    <link name="${prefix}wrist_link">
      <visual>
        <origin xyz="0 0 ${wrist_len/2}"/>
        <geometry><box size="0.040 0.045 ${wrist_len}"/></geometry>
        <material name="aluminum"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${wrist_len/2}"/>
        <geometry><box size="0.045 0.050 ${wrist_len}"/></geometry>
      </collision>
      <xacro:box_inertia m="0.09" x="0.04" y="0.045" z="${wrist_len}"/>
    </link>

    <!-- E: wrist roll (spins the gripper about the arm axis) -->
    <joint name="${prefix}wrist_roll_joint" type="revolute">
      <parent link="${prefix}wrist_link"/>
      <child link="${prefix}gripper_base_link"/>
      <origin xyz="0 0 ${wrist_len}"/>
      <axis xyz="0 0 1"/>
      <limit lower="${-lim}" upper="${lim}" effort="${effort_nm}" velocity="${vel_rads}"/>
    </joint>

    <link name="${prefix}gripper_base_link">
      <visual>
        <origin xyz="0 0 ${gripper_base_h/2}"/>
        <geometry><box size="0.045 0.038 ${gripper_base_h}"/></geometry>
        <material name="dark_gray"/>
      </visual>
      <collision>
        <origin xyz="0 0 ${gripper_base_h/2}"/>
        <geometry><box size="0.045 0.038 ${gripper_base_h}"/></geometry>
      </collision>
      <xacro:box_inertia m="0.10" x="0.045" y="0.038" z="${gripper_base_h}"/>
    </link>

    <!-- F: geared gripper. Left finger is driven, right one mirrors it. -->
    <joint name="${prefix}finger_l_joint" type="revolute">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}finger_l_link"/>
      <origin xyz="0 ${finger_sep/2} ${gripper_base_h}"/>
      <axis xyz="1 0 0"/>
      <limit lower="0.0" upper="1.0" effort="${effort_nm}" velocity="${vel_rads}"/>
    </joint>
    <link name="${prefix}finger_l_link">
      <visual>
        <origin xyz="0 0.004 ${finger_len/2}"/>
        <geometry><box size="0.010 0.008 ${finger_len}"/></geometry>
        <material name="aluminum"/>
      </visual>
      <collision>
        <origin xyz="0 0.004 ${finger_len/2}"/>
        <geometry><box size="0.010 0.008 ${finger_len}"/></geometry>
      </collision>
      <xacro:box_inertia m="0.02" x="0.01" y="0.008" z="${finger_len}"/>
    </link>

    <joint name="${prefix}finger_r_joint" type="revolute">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}finger_r_link"/>
      <origin xyz="0 ${-finger_sep/2} ${gripper_base_h}"/>
      <axis xyz="1 0 0"/>
      <limit lower="-1.0" upper="0.0" effort="${effort_nm}" velocity="${vel_rads}"/>
      <mimic joint="${prefix}finger_l_joint" multiplier="-1.0"/>
    </joint>
    <link name="${prefix}finger_r_link">
      <visual>
        <origin xyz="0 -0.004 ${finger_len/2}"/>
        <geometry><box size="0.010 0.008 ${finger_len}"/></geometry>
        <material name="aluminum"/>
      </visual>
      <collision>
        <origin xyz="0 -0.004 ${finger_len/2}"/>
        <geometry><box size="0.010 0.008 ${finger_len}"/></geometry>
      </collision>
      <xacro:box_inertia m="0.02" x="0.01" y="0.008" z="${finger_len}"/>
    </link>

    <!-- tool frame (gripper tip, the IK target for MoveIt2) -->
    <joint name="${prefix}tool0_joint" type="fixed">
      <parent link="${prefix}gripper_base_link"/>
      <child link="${prefix}tool0"/>
      <origin xyz="0 0 ${gripper_base_h + finger_len}"/>
    </joint>
    <link name="${prefix}tool0"/>

  </xacro:macro>
</robot>
